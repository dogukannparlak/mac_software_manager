# ==============================================================================
# Swift / SwiftPM  (GuideApp)
# ==============================================================================

# Build products. Roughly 100 MB of object files, rebuilt by `swift build`.
.build/
.swiftpm/

# Assembled application bundles are build output, not source
*.app/


# ==============================================================================
# Xcode
# ==============================================================================

DerivedData/
# tools/build_release.sh builds into its own derived data folder so a release
# build never reuses (or clobbers) the Debug one run.sh leaves behind.
DerivedData-release/
build/

# Per-user window layout, breakpoints and scheme state
xcuserdata/
*.xcuserstate
*.xcuserdatad/
*.xcscmblueprint
*.xccheckout

# Xcode 8+ / SwiftPM integration leftovers
*.moved-aside
*.hmap
*.ipa
*.dSYM.zip
*.dSYM

# Product > Archive output (the project's scheme has an ArchiveAction)
*.xcarchive/


# ==============================================================================
# Editors
# ==============================================================================

.vscode/
.idea/
*.swp
*~


# ==============================================================================
# Personal
# ==============================================================================
